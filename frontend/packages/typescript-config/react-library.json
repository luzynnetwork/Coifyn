{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // These packages ship raw .ts/.tsx via their `exports` map, so Next/
    // Turbopack bundles the source directly. Bundler resolution keeps the
    // imports extensionless; NodeNext would demand `.js` specifiers that
    // Turbopack cannot map back to `.ts`.
    "module": "ESNext",
    "moduleResolution": "Bundler"
  }
}
