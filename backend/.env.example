# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development
PORT=4000

# Postgres. The app should connect as a RESTRICTED role (no BYPASSRLS) so
# Row-Level Security is enforced. Migrations run as the owning role.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/coifyn

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional in the Phase 0 slice. When unset, the outbox relay worker does not
# start; domain events are still written to the domain_event table in-transaction.
# REDIS_URL=redis://localhost:6379

# Base host for per-salon subdomains (e.g. aurora.coifyn.app). Use "localhost" locally.
TENANT_BASE_HOST=localhost

LOG_LEVEL=debug
