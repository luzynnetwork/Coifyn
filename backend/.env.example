# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────
# Pick ONE of the two modes.
#
# Mode 1 — plain connection string (local Postgres, or any password-auth server):
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/coifyn
#
# Mode 2 — AWS RDS / Aurora with IAM auth (password is a 15-min token fetched
# per connection). Leave DATABASE_URL blank and set:
#   DB_IAM_AUTH=true
#   DB_HOST=database-1.cluster-xxxx.eu-north-1.rds.amazonaws.com
#   DB_PORT=5432
#   DB_NAME=coifyn
#   DB_USER=postgres
#   AWS_REGION=eu-north-1
# The Node process also needs AWS credentials — either AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN here, or AWS_PROFILE + a shared
# config file, or an instance role in production.

DB_IAM_AUTH=false

# The app should ultimately connect as a NON-superuser role so Row-Level Security
# applies. rds_superuser (the RDS master user) does NOT have BYPASSRLS, and every
# policied table is FORCE ROW LEVEL SECURITY, so the master user is acceptable
# for development; create a dedicated coifyn_app login before production.

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional in the Phase 0 slice. When unset, the outbox relay worker does not
# start; domain events are still written to domain_event in-transaction.
REDIS_URL=redis://localhost:6379

# Customer-facing JWT secrets — SEPARATE from JWT_ACCESS_SECRET/JWT_REFRESH_SECRET
# above so a customer token can never authenticate a staff route.
# generate with: openssl rand -base64 48
CUSTOMER_JWT_ACCESS_SECRET=
CUSTOMER_JWT_REFRESH_SECRET=
CUSTOMER_JWT_ACCESS_TTL=15m
CUSTOMER_JWT_REFRESH_TTL=30d

# ── Object storage (S3 / MinIO) ────────────────────────────────────────────
# Points at the compose MinIO by default. Point S3_ENDPOINT at real AWS S3 (and
# drop it) in staging/production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=coifyn-dev
S3_ACCESS_KEY_ID=coifyn
S3_SECRET_ACCESS_KEY=coifyn123
S3_FORCE_PATH_STYLE=true

# ── Mail (Mailpit locally) ──────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@coifyn.app
MAIL_SECURE=false
# MAIL_USER=
# MAIL_PASSWORD=

# ── Payments (Stripe, test mode) ────────────────────────────────────────────
# Leave unset to use the no-op payment provider (default in dev/test).
# STRIPE_SECRET_KEY=sk_test_...

# ── SMS (Twilio) — stub, not implemented until a later phase ───────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Observability ────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=coifyn-api
# SENTRY_DSN=

TENANT_BASE_HOST=localhost
LOG_LEVEL=debug
