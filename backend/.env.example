# Copy to .env and fill in. .env is git-ignored.

NODE_ENV=development
PORT=4000

# ── Database ────────────────────────────────────────────────────────────────
# Pick ONE of the two modes.
#
# Mode 1 — plain connection string (local Postgres, or any password-auth server):
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/coifyn
#
# Mode 2 — AWS RDS / Aurora with IAM auth (password is a 15-min token fetched
# per connection). Leave DATABASE_URL blank and set:
#   DB_IAM_AUTH=true
#   DB_HOST=database-1.cluster-xxxx.eu-north-1.rds.amazonaws.com
#   DB_PORT=5432
#   DB_NAME=coifyn
#   DB_USER=postgres
#   AWS_REGION=eu-north-1
# The Node process also needs AWS credentials — either AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN here, or AWS_PROFILE + a shared
# config file, or an instance role in production.

DB_IAM_AUTH=false

# The app should ultimately connect as a NON-superuser role so Row-Level Security
# applies. rds_superuser (the RDS master user) does NOT have BYPASSRLS, and every
# policied table is FORCE ROW LEVEL SECURITY, so the master user is acceptable
# for development; create a dedicated coifyn_app login before production.

# JWT secrets — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional in the Phase 0 slice. When unset, the outbox relay worker does not
# start; domain events are still written to domain_event in-transaction.
# REDIS_URL=redis://localhost:6379

TENANT_BASE_HOST=localhost
LOG_LEVEL=debug
